          "docs": "Get an order"
        },
        {
          "info": {
            "name": "List order items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sellingpartnerapi-na.amazon.com/orders/v0/orders/:orderId/orderItems",
            "params": [
              {
                "name": "orderId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List order items"
        }
      ]
    }
  ],
  "bundled": true
