              },
              {
                "name": "CreatedBefore",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List orders"
        },
        {
          "info": {
            "name": "Get an order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sellingpartnerapi-na.amazon.com/orders/v0/orders/:orderId",
