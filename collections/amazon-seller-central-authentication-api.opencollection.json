{
  "opencollection": "1.0.0",
  "info": {
    "name": "Amazon Selling Partner API (SP-API) Authentication API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-amz-access-token",
      "value": "{{x-amz-access-token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Exchange refresh token or client credentials for an LWA access token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sellingpartnerapi-na.amazon.com/auth/o2/token",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "refresh_token",
                  "value": ""
                },
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "client_secret",
                  "value": ""
                },
                {
                  "name": "scope",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Exchange refresh token or client credentials for an LWA access token"
        }
      ]
    }
  ],
  "bundled": true
}