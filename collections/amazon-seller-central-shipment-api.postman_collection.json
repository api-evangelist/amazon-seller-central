  "info": {
    "_postman_id": "befaee58-3234-4f0c-8499-ae95122acf5e",
    "name": "Selling Partner API for Orders Shipment API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Use the Orders Selling Partner API to programmatically retrieve order information. With this API, you can develop fast, flexible, and custom applications to manage order synchronization, perform order research, and create demand-based decision support tools. \n\n_Note:_ For the JP, AU, and SG marketplaces, the Orders API supports orders from 2016 onward. For all other marketplaces, the Orders API supports orders for the last two years (orders older than this don't show up in the response).\n\nContact Support:\n Name: Selling Partner API Developer Support",
      "type": "text/plain"
    }
  }
